# ==========================================================
# AI Resume Screening System - Environment Configuration
# ==========================================================
# 1. Copy this file and rename it to exactly: .env
# 2. Replace the values below with your real Google API credentials

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=523422351530-8hqbui824eat6c1v8rj1scjup9amvqtq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Flask Security (Optional: change this for production)
SECRET_KEY=ai-resume-screener-safe-secret-key

# OCR Provider
# Set to false to disable dots.mocr VLM and use only Tesseract (faster, less accurate)
USE_MOCR=true

# Prevent Rust tokenizer mutex crash on macOS (required for dots.mocr)
TOKENIZERS_PARALLELISM=false
