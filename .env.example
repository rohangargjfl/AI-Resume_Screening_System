# ==========================================================
# AI Resume Screening System - Environment Configuration
# ==========================================================
# 1. Copy this file and rename it to exactly: .env
# 2. Replace the values below with your real Google API credentials

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Flask Security (Optional: change this for production)
SECRET_KEY="YOUR_SECRET_KEY"
